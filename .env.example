# Copy to .env.local for local development, and add the same keys in Vercel
# (Project Settings > Environment Variables).

# Contact form (https://resend.com). The "from" address must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=admin@xyvin.com
CONTACT_FROM_EMAIL="Xyvin Website <website@xyvin.com>"

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics and the consent banner.
NEXT_PUBLIC_GA_ID=
